---
import type { ImageMetadata } from "astro";
import { twMerge } from "tailwind-merge";
import ResponsivePicture, {
  type Props as ResponsivePictureProps,
} from "../ResponsivePicture.astro";

type Props = Omit<ResponsivePictureProps, "src"> & {
  src: ImageMetadata;
};

const { class: className, src, ...attributes } = Astro.props;
---

<a
  href={src.src}
  target="_blank"
  rel="noopener noreferrer"
  class="block w-full"
>
  <ResponsivePicture
    {...attributes}
    src={src}
    class={twMerge(
      className,
      "aspect-auto rounded-md border-2 border-gray-400",
    )}
  />
</a>
