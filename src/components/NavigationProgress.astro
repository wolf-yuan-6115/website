---
import type { Locale } from "../i18n/config";
import { getMessages } from "../i18n/messages";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getMessages(locale).loader;
---

<div
  id="navigation-progress"
  class="pointer-events-none fixed inset-x-0 top-0 z-50 h-1 opacity-0 transition-opacity duration-500 ease-out motion-reduce:transition-none"
  role="progressbar"
  aria-label={t.loading}
  aria-hidden="true"
  transition:persist="navigation-progress"
  transition:animate="none"
>
  <div
    data-progress-fill
    data-reset="true"
    data-complete="false"
    aria-hidden="true"
    class="h-full w-[var(--navigation-progress,0%)] bg-indigo-400 drop-shadow-sm drop-shadow-indigo-400/60 transition-[width] duration-1000 ease-linear data-[complete=true]:ease-out data-[reset=true]:transition-none motion-reduce:transition-none"
  ></div>
</div>

<script>
  import { createNavigationProgress } from "../lib/navigation-progress";
  import { createNavigationProgressView } from "../lib/navigation-progress-view";

  const bar = document.getElementById("navigation-progress")!;
  const fill = bar.querySelector<HTMLElement>(
    "[data-progress-fill]",
  )!;
  const view = createNavigationProgressView(bar, fill);
  const progress = createNavigationProgress(view.render);

  let active:
    | { id: number; signal: AbortSignal; cleanup: () => void }
    | undefined;
  const listeners = new AbortController();

  function stop(id: number, complete = false) {
    if (active?.id !== id) return;
    active.cleanup();
    active = undefined;
    view.resume();
    if (complete) progress.complete(id);
    else progress.cancel(id);
  }

  document.addEventListener(
    "astro:before-preparation",
    (event) => {
      if (event.defaultPrevented || event.signal.aborted) return;
      active?.cleanup();
      view.resume();
      const id = progress.start();
      const abort = () => stop(id);
      event.signal.addEventListener("abort", abort, { once: true });
      active = {
        id,
        signal: event.signal,
        cleanup: () =>
          event.signal.removeEventListener("abort", abort),
      };

      // A later event handler may cancel preparation before its loader runs.
      queueMicrotask(() => {
        if (event.defaultPrevented || event.signal.aborted) stop(id);
      });

      const load = event.loader;
      event.loader = async () => {
        try {
          await load();
          if (event.defaultPrevented || event.signal.aborted)
            stop(id);
          else progress.prepared(id);
        } catch (error) {
          stop(id);
          throw error;
        }
      };
    },
    { signal: listeners.signal },
  );

  document.addEventListener(
    "astro:before-swap",
    (event) => {
      if (!active || active.signal !== event.signal) return;
      const id = active.id;
      // Reparenting a persisted element can discard its running CSS transition.
      // Keep the actual drawn width, rather than jumping to its pending target.
      view.freeze();
      const label = event.newDocument
        .getElementById("navigation-progress")
        ?.getAttribute("aria-label");
      void event.viewTransition.updateCallbackDone.then(
        () => {
          if (active?.id !== id) return;
          // The persisted indicator must adopt the destination page's language.
          if (label) bar.setAttribute("aria-label", label);
          stop(id, true);
        },
        () => stop(id),
      );
    },
    { signal: listeners.signal },
  );

  function reset() {
    active?.cleanup();
    active = undefined;
    view.resume();
    progress.reset();
  }

  window.addEventListener("pagehide", reset, {
    signal: listeners.signal,
  });
  window.addEventListener(
    "pageshow",
    (event) => {
      if (event.persisted) reset();
    },
    { signal: listeners.signal },
  );

  if (import.meta.hot) {
    import.meta.hot.dispose(() => {
      listeners.abort();
      reset();
    });
  }
</script>
