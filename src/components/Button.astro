---
import { twMerge } from "tailwind-merge";

interface Props {
  class?: string;
  link: string;
  target?: "_self" | "_blank";
  glow?: boolean;
  prefetch?: "tap" | "hover" | "viewport" | "load";
}

const {
  class: className,
  link,
  target = "_self",
  glow = false,
  prefetch,
} = Astro.props;
---

<a
  href={link}
  target={target}
  rel={target === "_blank" ? "noopener noreferrer" : undefined}
  data-astro-prefetch={prefetch}
  class={twMerge(
    "inline-flex h-max w-max place-items-center space-x-3 rounded-sm border-2 border-solid border-emerald-200 bg-gray-800 px-4 py-3 duration-300 hover:bg-emerald-200 hover:text-gray-800 hover:shadow-emerald-200",
    glow && "hover:shadow-[0_0_15px_4px]",
    className,
  )}
>
  <slot />
</a>
