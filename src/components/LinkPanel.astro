---
import { twMerge } from "tailwind-merge";

interface Props {
  href: string;
  target?: "_self" | "_blank";
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  target = "_self",
  class: className,
  ariaLabel,
} = Astro.props;
---

<a
  href={href}
  target={target}
  rel={target === "_blank" ? "noopener noreferrer" : undefined}
  aria-label={ariaLabel}
  class="block"
>
  <div
    class={twMerge(
      "transform-gpu rounded-md border-2 border-solid border-emerald-200 bg-gray-800 px-5 py-5 duration-300 hover:bg-emerald-200 hover:text-gray-800 md:hover:scale-105",
      className,
    )}
  >
    <slot />
  </div>
</a>
