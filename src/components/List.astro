---
import { Icon } from "astro-icon/components";
import LinkPanel from "./LinkPanel.astro";

interface Props {
  class?: string;
  title: string;
  description: string;
  link: string;
  icons: string[];
  changed?: string;
}

const {
  class: className,
  title,
  description,
  link,
  icons,
  changed,
} = Astro.props;
---

<div>
  <LinkPanel href={link} target="_blank" class={className}>
    <div class="grid grid-flow-col">
      <p
        class="my-auto place-self-start text-lg font-semibold md:text-xl"
      >
        {title}
      </p>
      <div class="place-self-end text-xl md:text-2xl">
        {icons.map((i) => <Icon name={i} class="mx-2 inline" />)}
      </div>
    </div>
    <p class="pt-4 text-sm md:text-base">{description}</p>
    {
      changed && (
        <p class="pt-4 text-sm md:text-base">
          <Icon name="material-symbols:bolt-rounded" class="inline" />
          <span class="font-bold">{changed}</span>
        </p>
      )
    }
  </LinkPanel>
</div>
