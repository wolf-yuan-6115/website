---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { twMerge } from "tailwind-merge";

import avatarImage from "../assets/transparent_2000x2000.png";
import { getLocalePath, type Locale } from "../i18n/config";
import { getMessages } from "../i18n/messages";

interface Props {
  locale: Locale;
  alternateUrls?: Partial<Record<Locale, string>>;
  fullPage?: boolean;
}

const { locale, alternateUrls = {}, fullPage = false } = Astro.props;
const t = getMessages(locale).nav;
const alternateLocale: Locale = locale === "en" ? "zh-tw" : "en";
const alternateUrl = alternateUrls[alternateLocale];
---

{
  /* Keep background-size inline because Tailwind parses this value as a position. */
}
<nav
  class={twMerge(
    "js:nav-container bg-linear-to-b from-gray-950/85 via-transparent to-transparent bg-bottom top-0 z-10 flex justify-center duration-300 transition-all",
    fullPage ? "fixed w-full xl:sticky" : "sticky",
  )}
  style={{ backgroundSize: "100% 200%" }}
>
  <div
    class="js:nav-padding z-30 w-full max-w-7xl px-5 py-6 duration-300"
  >
    <div class="flex justify-between">
      <div>
        <div class="flex flex-row items-center gap-4">
          <a href={getLocalePath(locale)} aria-label={t.imageAlt}>
            <div>
              <Image
                src={avatarImage}
                alt="Wolf Yuan avatar"
                width={56}
                height={56}
                class="h-9 w-9 object-fill"
                loading="eager"
              />
              <p class="sr-only">
                {t.imageAlt}
              </p>
            </div>
          </a>
          <a href={getLocalePath(locale)} data-astro-prefetch>
            <div
              class="js:nav-title text-lg font-bold opacity-0 transition-opacity duration-300 sm:opacity-0"
            >
              Wolf Yuan
            </div>
            <p class="sr-only">
              {t.imageAlt}
            </p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex h-10 items-center justify-end gap-6">
          <div>
            <a
              href={getLocalePath(locale, "/blog/")}
              class="text-gray-300 duration-300 hover:text-gray-50"
            >
              <div class="flex items-center justify-between md:gap-2">
                <Icon
                  name="material-symbols:newspaper-rounded"
                  class="text-lg md:text-base"
                />
                <p class="sr-only md:not-sr-only">{t.blogTitle}</p>
              </div>
            </a>
          </div>
          {
            alternateUrl && (
              <div>
                <a
                  href={alternateUrl}
                  class="text-gray-300 duration-300 hover:text-gray-50"
                >
                  <div class="flex items-center justify-between md:gap-2">
                    <Icon
                      name="material-symbols:translate-rounded"
                      class="text-lg md:text-base"
                    />
                    <p class="sr-only inline md:not-sr-only">
                      {t.switchLanguage}
                    </p>
                  </div>
                </a>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>

  <div
    class="blur-container absolute top-0 left-0 z-20 h-full w-full"
  >
    <div class="blur-filter"></div>
    <div class="blur-filter"></div>
    <div class="blur-filter"></div>
    <div class="blur-filter"></div>
    <div class="blur-filter"></div>
  </div>

  <style>
    .blur-filter {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 100%;
    }

    /*
     The blur filter has 5 layers w/ around 20% overlap
    */

    .blur-container {
      .blur-filter:nth-child(1) {
        backdrop-filter: blur(3.8px);
        mask: linear-gradient(
          to bottom,
          rgba(0, 0, 0, 1) 0%,
          rgba(0, 0, 0, 1) 28.5%,
          rgba(0, 0, 0, 0.7) 42.3%,
          rgba(0, 0, 0, 0) 52.1%
        );
      }

      .blur-filter:nth-child(2) {
        backdrop-filter: blur(2.5px);
        mask: linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0) 18.7%,
          rgba(0, 0, 0, 0.6) 32.4%,
          rgba(0, 0, 0, 1) 41.8%,
          rgba(0, 0, 0, 1) 58.9%,
          rgba(0, 0, 0, 0.5) 68.2%,
          rgba(0, 0, 0, 0) 76.3%
        );
      }

      .blur-filter:nth-child(3) {
        backdrop-filter: blur(1.2px);
        mask: linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0) 33.7%,
          rgba(0, 0, 0, 0.4) 47.9%,
          rgba(0, 0, 0, 1) 56.2%,
          rgba(0, 0, 0, 1) 73.8%,
          rgba(0, 0, 0, 0.6) 82.5%,
          rgba(0, 0, 0, 0) 89.4%
        );
      }

      .blur-filter:nth-child(4) {
        backdrop-filter: blur(0.8px);
        mask: linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0) 48.3%,
          rgba(0, 0, 0, 0.3) 62.7%,
          rgba(0, 0, 0, 1) 71.5%,
          rgba(0, 0, 0, 1) 86.9%,
          rgba(0, 0, 0, 0.7) 93.2%,
          rgba(0, 0, 0, 0) 98.1%
        );
      }

      .blur-filter:nth-child(5) {
        backdrop-filter: blur(0.4px);
        mask: linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0) 73.6%,
          rgba(0, 0, 0, 0.4) 84.2%,
          rgba(0, 0, 0, 0.8) 91.7%,
          rgba(0, 0, 0, 1) 100%
        );
      }
    }
  </style>
</nav>

<script>
  document.addEventListener("astro:page-load", () => {
    const navContainer = document.querySelector<HTMLElement>(
      ".js\\:nav-container",
    );
    const navPaddingArea = document.querySelector<HTMLElement>(
      ".js\\:nav-padding",
    );
    const navTitleElement =
      document.querySelector<HTMLElement>(".js\\:nav-title");

    if (!navContainer || !navPaddingArea || !navTitleElement) return;

    const container = navContainer;
    const paddingArea = navPaddingArea;
    const titleElement = navTitleElement;
    let currentState = false;

    function compareScrollDistance() {
      if (window.scrollY > 52) {
        if (currentState) return;
        currentState = true;
        changeState(true);
      } else if (window.scrollY < 38) {
        currentState = false;
        changeState(false);
      }
    }

    function changeState(state: boolean) {
      if (state) {
        container.classList.add("bg-top");
        container.classList.remove("bg-bottom");

        paddingArea.classList.add("py-4");
        paddingArea.classList.remove("py-6");

        titleElement.classList.add("sm:opacity-100");
        titleElement.classList.remove("sm:opacity-0");
      } else {
        container.classList.add("bg-bottom");
        container.classList.remove("bg-top");

        paddingArea.classList.add("py-6");
        paddingArea.classList.remove("py-4");

        titleElement.classList.add("sm:opacity-0");
        titleElement.classList.remove("sm:opacity-100");
      }
    }

    function removeListener() {
      window.removeEventListener("scroll", compareScrollDistance);
      document.removeEventListener(
        "astro:before-swap",
        removeListener,
      );
    }

    window.addEventListener("scroll", compareScrollDistance);
    compareScrollDistance();

    document.addEventListener("astro:before-swap", removeListener);
  });
</script>
