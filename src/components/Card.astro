---
import { Icon } from "astro-icon/components";
import LinkPanel from "./LinkPanel.astro";
import type { Locale } from "../i18n/config";
import { getMessages } from "../i18n/messages";

interface Props {
  locale: Locale;
  class?: string;
  title: string;
  description: string;
  link: string;
  linkDescription: string;
  target?: "_self" | "_blank";
  icons: string[];
  appearedIn?: string;
}

const {
  locale,
  class: className,
  title,
  description,
  link,
  linkDescription,
  target,
  icons,
  appearedIn,
} = Astro.props;
const t = getMessages(locale).card;
---

<div>
  <LinkPanel href={link} target={target} class={className}>
    <div class="grid min-h-72 md:min-h-64">
      <div>
        <div class="grid grid-flow-col">
          <p
            class="my-auto place-self-start text-lg font-semibold md:text-xl"
          >
            {title}
          </p>
          <div class="place-self-end text-xl md:text-2xl">
            {icons.map((i) => <Icon name={i} class="mx-2 inline" />)}
          </div>
        </div>
        <p class="py-4 text-sm md:text-base">{description}</p>
        {
          appearedIn && (
            <p class="pt-2 text-sm md:text-base">
              <Icon
                name="material-symbols:bolt-rounded"
                class="inline"
              />
              {t.appeared} <span class="font-bold">{appearedIn}</span>
              {t.appearedAfter}
            </p>
          )
        }
      </div>
      <div class="w-full place-self-end text-sm">
        {t.link}{" "}
        <span class="font-bold">{linkDescription}</span>
        <Icon
          name="material-symbols:arrow-forward-rounded"
          class="inline"
        />
      </div>
    </div>
  </LinkPanel>
</div>
